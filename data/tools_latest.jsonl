{"id": "amazonmacie", "name": "Amazon Macie", "category": "pii", "doc": "Amazon Macie scans objects in Amazon S3 for sensitive data with managed data identifiers. They cover credentials and private keys, financial data such as card and bank account numbers, health identifiers, and personal identifiers such as passport, driver's license and tax numbers for a list of countries. Many identifiers report a match only when a keyword is near the value.", "website": "https://docs.aws.amazon.com/macie/latest/user/mdis-reference-quick.html", "supported_types": ["aadhaar", "address", "aeiban", "ardni", "at_driver_license", "au_driver_license", "autfn", "aws_secret_access_key", "bankaccount", "bankcard", "be_driver_license", "bg_driver_license", "birthday", "br_postcode", "brcpf", "ca_bank_account", "cadriverlic", "capassport", "casin", "chiban", "cl_rut", "cnpj", "co_nit", "cpf", "cptcode", "cuit", "curp", "cy_driver_license", "cz_driver_license", "de_passport", "dedriverlic", "depersonalausweis", "dk_driver_license", "ee_driver_license", "egiban", "es_ccc", "es_dni", "es_iban", "es_nss", "esdriverlic", "esnie", "esnif", "espassport", "fi_driver_license", "fi_ehic", "fr_driver_license", "fr_health_insurance_number", "fr_nif", "frcni", "frpassport", "gb_electoral_roll_number", "geopoint", "google_api_key", "gr_driver_license", "hr_driver_license", "http_authorization_header", "hu_driver_license", "iban", "ie_driver_license", "in_driver_license", "it_codicefiscale", "it_driver_license", "it_passport", "jwt", "lt_driver_license", "lu_driver_license", "lv_driver_license", "me_iban", "mt_driver_license", "nanpphone", "nhsnumber", "nif", "nl_driver_license", "npi", "pan", "person_fullname", "pgp_private_key_block", "phone", "pldriverlic", "pliban", "private_key", "pt_driver_license", "rfc", "rg", "ro_driver_license", "se_driver_license", "si_driver_license", "sk_driver_license", "steuerid", "stripe_api_key", "tfn", "triban", "ukdriverlic", "uknhsnum", "uknino", "ukpassport", "ukutr"