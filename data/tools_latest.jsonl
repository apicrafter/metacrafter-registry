{"id": "fta", "name": "FTA (Fast Text Analysis)", "category": "detector", "doc": "Java library by Tim Segall that profiles a stream of values and infers its base type, format and semantic type, for example EMAIL, IDENTITY.VAT_FR or POSTAL_CODE.ZIP5_US. It ships about 260 semantic types, many of them for specific locales. The registry records that FTA detects carry the FTA name in mappings.fta; this list is derived from them.", "website": "https://github.com/tsegall/fta", "supported_types": ["aadhaar", "abaroutingnum", "address", "address_line2", "age", "age_range", "airlinename", "at_postcode", "at_vat", "au_postcode", "au_state", "au_state_code", "au_suburb", "bg_postcode", "birth_year", "birthday", "br_municipality", "br_municipality_code", "br_postcode", "br_state", "br_state_code", "bsn", "buildingnumber", "ca_postcode", "caprovince", "caprovincecode", "cardinal_direction", "casin", "ch_canton", "ch_canton_code", "ch_postcode", "chahv", "city", "co_department", "co_municipality", "co_postcode", "color", "continent", "continentcode", "country", "countrycode_alpha2", "countrycode_alpha3", "cryptocurrency", "currency", "cusip", "dayofmonth", "dayofweek", "de_postcode", "de_state", "decountryname", "district", "dk_postcode", "duns", "ean", "easting", "ec_province", "email", "encountryname", "ennationality", "es_province", "espostcode", "esvat", "fi_postcode", "file_extension", "filename", "fips52", "fips64", "fr_department", "fr_region", "frnir", "frpostcode", "frvat", "gb_county", "gb_vat", "gender", "geojson", "geopoint", "half_year", "hexcolor", "honorificprefix", "hu_county", "ianatimezoneid", "iataairlinecode", "iataairportcode", "iban", "id", "ie_county", "ie_province", "imei", "in_postcode", "industry", "inseecode", "ipv4", "ipv6", "isbn13", "isin", "iso3166_mx3a", "iso3166code", "iso4217curcode", "iso4217curname", "iso639_1", "iso639_2", "it_comune", "it_iva", "it_postcode", "it_province", "it_province_code", "it_region", "jobtitle", "jp_postcode", "jp_prefe