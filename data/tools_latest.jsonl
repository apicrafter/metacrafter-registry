{"id": "auctus", "name": "Auctus", "category": "other", "doc": "This project is a web crawler and search engine for datasets, specifically meant for data augmentation tasks in machine learning. It is able to find datasets in different repositories and index them for later retrieval.", "website": "https://gitlab.com/ViDA-NYU/auctus/auctus", "supported_types": ["datetime", "id", "latitude", "longitude", "geopoint", "address", "url", "filename", "boolean"], "num": 9}
{"id": "databricks", "name": "Databricks Unity Catalog data classification", "category": "pii", "doc": "Data classification in Databricks Unity Catalog scans the tables of a catalog with an AI agent and tags columns with classes such as class.email_address, class.iban_code or class.us_ssn. Global classes apply everywhere; regional classes for national identifiers are detected only in the matching cloud regions.", "website": "https://docs.databricks.com/aws/en/data-governance/unity-catalog/data-classification-tags", "supported_types": ["aadhaar", "aeemiratesid", "age", "aumedicarenum", "autfn", "bankaccount", "bankcard", "bic", "birthday", "brcpf", "bsn", "casin", "chahv", "cif", "cnpj", "cpf", "curp", "depersonalausweis", "dkcprnum", "email", "es_dni", "esnie", "fr_nif", "frcni", "frnir", "gender", "geopoint", "hk_hkid", "iban", "idcard", "il_idnr", "imei", "in_epic", "ipaddr", "it_codicefiscale", "it_iva", "jp_pension_number", "krbusinessreg", "krrrn", "mac_address", "marital_status", "medicare", "mynumber", "nhsnumber", "no_fodselsnummer", "npi", "nric", "nz_ird", "nz_nhi", "pan", "passport", "person_fullname", "phone", "race_ethnicity", "religion", "rfc", "rg", "sepersonnummer", "sgnric", "steuerid", "street_address", "swiftcode", "tfn", "uknhsnum", "uknino", "uksortcode", "ukutr", "url", "usbankaccount", "usdriverlic", "usitin", "usnpi", "uspassport", "usssn", "vehiclenumber", "vin", "za_id"], "num": 77}
{"id": "dataprep", "name": "DataPrep", "category": "etl", "doc": "DataPrep is an open-source Python library for data preparation from the SFU Database Group. Its clean module standardises and validates the values of a DataFrame column: national identifiers, tax and VAT numbers, company registration numbers, bank account numbers and product, publication and securities codes (most of them checked with python-stdnum), as well as email addresses, phone numbers, URLs, IP addresses, dates, coordinates, countries and addresses.", "website": "https://github.com/sfu-db/dataprep", "supported_types": ["aadhaar", "ad_nrt", "address", "al_nipt", "ar_cbu", "ardni", "at_vat", "at_vnr", "auabn", "auacn", "autfn", "be_iban", "be_vat", "bg_egn", "bg_pnf", "bg_vat", "bic", "brcpf", "bsn", "by_unp", "cabn", "casin", "casrn", "ch_esr", "chahv", "chuid", "cif", "cl_rut", "cnpj", "co_nit", "country", "cr_cpf", "cr_cpj", "cr_cr", "cu_ni", "cuit", "curp", "currency", "cusip", "cy_vat", "cz_dic", "cz_rc", "date", "datetime", "de_stnr", "de_wkn", "deust", "dk_cvr", "dkcprnum", "do_cedula", "do_ncf", "do_rnc", "ean", "ec_ci", "ec_ruc", "ee_ik", "ee_kmkr", "ee_registrikood", "email", "es_ccc", "es_cups", "es_dni", "es_iban", "es_referenciacatastral", "esnie", "esnif", "eu_at_02", "eu_banknote", "eu_eic", "eu_nace", "fi_alv", "fi_associationid", "fi_hetu", "fi_veronumero", "fi_ytunnus", "figi", "fr_nif", "frnir", "frvat", "gb_upn", "gb_vat", "geopoint", "gr_amka", "gr_vat", "grid_release", "gt_nit", "handelsregisternr", "hr_oib", "hu_anum", "iban", "idcard", "idnpwp", "ie_pps", "ie_vat", "il_hp", "il_idnr", "imei", "imonumber", "imsi", "ipaddr", "ipv4", "ipv6", "is_kennitala", "is_vsk", "isan", "isbn10", "isbn13", "isil", "isin", "ismn", "issn", "it_aic", "it_codicefiscale", "it_iva", "jp_cn", "krbusinessreg", "krrrn", "lei", "li_peid", "lt_asmens", "lt_pvm", "lu_tva", "lv_pvn", "mc_tva", "md_idno", "me_iban", "meid", "mt_vat", "mu_nid", "my_nric", "nl_brin", "nl_onderwijsnummer", "nl_postcode",