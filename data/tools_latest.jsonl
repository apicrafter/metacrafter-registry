{"id": "gitleaks", "name": "Gitleaks", "category": "detector", "doc": "Open-source (MIT) secret scanner that finds hard-coded credentials, such as API keys, access tokens and private keys, in git history, directories and standard input. Its rules combine regular expressions with keywords and entropy checks. The list of supported types covers only the registry datatypes that match a gitleaks rule.", "website": "https://github.com/gitleaks/gitleaks", "supported_types": ["aws_access_key_id", "facebook_app_access_token", "github_token", "google_api_key", "heroku_oauth_token", "jfrog_api_key", "jfrog_reference_token", "jwt", "mailchimp_api_key", "npm_access_token", "pgp_private_key_block", "sendgrid_api_key", "slack_token", "slack_webhook_url", "sonarqube_token", "square_access_token", "stripe_api_key", "telegram_bot_token", "twilio_api_key_sid", "x509_private_key"], "num": 20}
{"id": "googledatastudio", "name": "Google Data Studio", "category": "other", "doc": "With Data Studio, you can easily report on data from a wide variety of sources, without programing. In just a few moments, you can connect to data sets such as: Databases, including BigQuery, MySQL, and PostgreSQL. Google Marketing Platform products, including Google Ads, Analytics, Display & Video 360, Search Ads 360.", "website": "https://developers.google.com/datastudio/connector/semantics#semantic-type-detection", "supported_types": ["geopoint", "country", "city", "datetime", "time", "address", "person_name", "year", "date", "month", "day", "dayofweek", "boolean", "url"], "num": 14}
{"id": "googledlp", "name": "Google Cloud Sensitive Data Protection (DLP)", "category": "pii", "doc": "Google Cloud Sensitive Data Protection, formerly Cloud DLP, inspects text, files, BigQuery and Cloud Storage with built-in infoType detectors: names, contact details, credentials, financial data, medical codes and national identifiers of many countries. Findings can be masked, tokenized or redacted. Each registry record lists the matching infoType names in mappings.google_dlp.", "website": "https://cloud.google.com/sensitive-data-protection/docs/infotypes-reference", "supported_types": ["aadhaar", "aumedicarenum", "autfn", "bankcard", "bic", "brcpf", "bsn", "capassport", "casin", "cpf", "curp", "depersonalausweis", "dkcprnum", "email", "es_dni", "esnif", "espassport", "euvat", "fi_hetu", "frcni", "frnir", "frpassport", "iban", "icd10", "imei", "ipaddr", "it_codicefiscale", "jp_driver_license", "jp_passport", "mac_address", "medicare", "mynumber", "nhsnumber", "nif", "no_fodselsnummer", "npi", "nric", "pan", "person_fullname", "phone", "plpesel", "sepersonnummer", "sgnric", "swiftcode", "uknhsnum", "uknino", "ukpassport", "ukutr", "url", "usdeanumber", "usdriverlic", "usein", "usitin", "usnpi", "uspassport", "usssn", "vatin"], "num": 57}
