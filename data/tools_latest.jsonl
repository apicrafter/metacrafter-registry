{"id": "metadata-guardian", "name": "Metadata Guardian", "category": "pii", "doc": "Metadata Guardian is a Python package that provides an easy way to protect your data sources by searching its metadata. By searching with data rules, it will detect what you are looking to protect. Using Rust, it makes blazing fast multi-regex matching.", "website": "https://github.com/fvaleye/metadata-guardian", "supported_types": ["email", "phone", "ipv4", "ipv6", "ipaddr", "postindex", "address", "person_firstname", "person_surname", "person_fullname", "birthday", "gender", "nationality", "username", "password"], "num": 15}
{"id": "microsoftpurview", "name": "Microsoft Purview Data Loss Prevention", "category": "pii", "doc": "Microsoft Purview (formerly Microsoft 365 compliance) finds sensitive data in Microsoft 365, endpoints and connected sources with built-in sensitive information types: national identifiers, financial data, credentials, medical terms and addresses. Each registry record lists the matching type names in mappings.purview.", "website": "https://learn.microsoft.com/en-us/purview/sensitive-information-type-entity-definitions", "supported_types": ["aadhaar", "abaroutingnum", "abn", "access_token", "address", "aeemiratesid", "api_key", "ardni", "at_driver_license", "at_passport", "at_tin", "at_vat", "at_vnr", "au_bank_account", "au_driver_license", "auabn", "auacn", "aumedicarenum", "aupassport", "autfn", "aws_secret_access_key", "azure_storage_account_key", "bankcard", "be_driver_license", "be_passport", "be_vat", "benatcardid", "bg_driver_license", "bg_egn", "bg_passport", "bic", "brcpf", "bsn", "ca_bank_account", "ca_phin", "cabcphn", "cadriverlic", "capassport", "casin", "chahv", "cl_rut", "cnpj", "connection_string", "cpf", "cuit", "curp", "cy_driver_license", "cy_id_card", "cy_passport", "cy_tin", "cz_driver_license", "cz_passport", "cz_rc", "de_passport", "dedriverlic", "depersonalausweis", "deust", "dk_driver_license", "dk_passport", "dkcprnum", "ee_driver_license", "ee_ik", "ee_passport", "es_dni", "es_nss", "esdriverlic", "esnif", "espassport", "fi_driver_license", "fi_ehic", "fi_hetu", "fi_passport", "fr_driver_license", "fr_health_insurance_number", "fr_nif", "frcni", "frnir", "frpassport", "frvat", "gb_electoral_roll_number", "github_token", "google_api_key", "gr_amka", "gr_driver_license", "gr_id_card", "gr_passport", "gr_vat", "hk_hkid", "hr_driver_license", "hr_id_card", "hr_oib", "hr_passport", "http_authorization_header", "hu_anum", "hu_driver_license", "hu_passport", "hu_personal_id", "hu_taj", "hu_tin", "iban", "icd10", "idcard", "idnik", "ie_driver_lic